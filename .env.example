# Copy to .env and fill in. .env is git-ignored.

# Chat agent: an Anthropic API key makes chat understanding run on a deployed server (no local Codex login).
# When set, chat uses the Anthropic API; when empty, Pearl falls back to the local Codex CLI, and to the
# deterministic parser if neither is available.
ANTHROPIC_API_KEY=
# Optional: which model acts as the agent (default: claude-sonnet-5). Use claude-haiku-4-5 for the cheapest
# runs or claude-opus-5 for the most capable.
# PEARL_AI_MODEL=claude-sonnet-5

# Browserbase: enables server-side auto booking on a remote cloud browser. Just the API key — no project id needed.
BROWSERBASE_API_KEY=
# Optional: residential proxies / captcha solving (paid plan) to clear reCAPTCHA on submit.
# BROWSERBASE_PROXIES=1
# BROWSERBASE_SOLVE_CAPTCHAS=1

# Optional: force a booking mode (default: handoff, or auto when a Browserbase key is set)
# PEARL_BOOKING_MODE=auto
