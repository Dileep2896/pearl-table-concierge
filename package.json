{
  "name": "pearl-table-concierge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chat agent that finds real restaurant availability on SevenRooms, shows every open time, and books a table after the diner confirms. No paid APIs.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "demo": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "api": "node --env-file-if-exists=.env --import tsx server/main.ts",
    "web": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "playwright install chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@browserbasehq/sdk": "^2.21.0",
    "@hono/node-server": "^1.19.0",
    "chrono-node": "^2.9.0",
    "hono": "^4.10.0",
    "motion": "^12.43.0",
    "playwright": "^1.63.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
